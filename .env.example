# SmartWork AI MVP - Environment Variables
# Copy this file to .env (make init does it for you)

# Publish ports (chosen to avoid conflicts with other local projects)
BACKEND_PORT=8100
FRONTEND_PORT=3100
POSTGRES_PORT=5442
REDIS_PORT=6390
CHROMA_PUBLISHED_PORT=8101
OLLAMA_PORT=11444
REDIS_COMMANDER_PORT=8181

# Database (used by docker compose)
POSTGRES_DB=smartwork
POSTGRES_USER=smartwork
POSTGRES_PASSWORD=smartwork

# Database (used when running the backend outside Docker)
DATABASE_URL=postgresql://smartwork:smartwork@localhost:5442/smartwork

# Redis
REDIS_URL=redis://localhost:6390/0

# Ollama LLM
# Inside Docker the backend reaches a host-installed Ollama through host.docker.internal.
# Set to http://ollama:11434 when using `docker compose --profile ai up`.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8100

# Security
SECRET_KEY=change-this-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
ENVIRONMENT=development
DEBUG=True

# Docker image tag (production)
TAG=latest
